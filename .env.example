# Supabase environment configuration (PLACEHOLDER ONLY)
# Copy this file to .env and fill in real values from your Supabase project.
# DO NOT commit a real .env file.
# DO NOT put the service_role key, database password, or any other secret
# in this file or in any frontend JavaScript. Only the public anon/publishable
# key belongs in the frontend, and only when RLS is correctly configured.

# Public Supabase project URL (safe for the browser)
SUPABASE_URL=

# Public anon / publishable key (safe for the browser when RLS is enabled)
SUPABASE_ANON_KEY=

# Server-only: service_role key. NEVER expose to the browser. Used only by
# trusted server-side jobs (e.g. an admin backend or a Supabase Edge Function).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only required if you run Supabase locally with the Supabase CLI
# and you want the migration scripts to connect directly to Postgres.
SUPABASE_DB_URL=
